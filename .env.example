# Sao chép file này thành .env và điền API key thật (không commit .env).
APOLLO_API_KEY=

# Web API (saletool web serve)
SALETOOL_SECRET_KEY=
SALETOOL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database backend: sqlite (mặc định) | mongo
SALETOOL_DB_BACKEND=sqlite
SALETOOL_DB_PATH=saletool.db
# SALETOOL_MONGO_URI=mongodb://localhost:27017
# SALETOOL_MONGO_DB=saletool
