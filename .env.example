# Sao chép file này thành .env và điền API key thật (không commit .env).
APOLLO_API_KEY=

# Web API (saletool web serve)
SALETOOL_SECRET_KEY=
SALETOOL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database backend: sqlite (mặc định) | mongo
SALETOOL_DB_BACKEND=sqlite
SALETOOL_DB_PATH=saletool.db
# SALETOOL_MONGO_URI=mongodb://localhost:27017
# SALETOOL_MONGO_DB=saletool

# SALETOOL_SECRET_KEY cũng là khoá dùng để mã hoá API key lưu trong DB
# (LLM/search key nhập ở trang Settings). Đổi khoá này => phải nhập lại các key đó.

# NO_PROXY: nếu deploy sau outbound proxy, thêm domain nội bộ vào đây để
# enrichment không bị proxy chặn.
# NO_PROXY=localhost,127.0.0.1

# --- Chỉ dùng cho Docker Compose (xem docs/docker.md) ---
# Compose đọc file .env này để thay ${...} trong docker-compose.yml; bản thân
# ứng dụng vẫn không tự nạp .env.
# Cổng mở giao diện web trên máy host.
SALETOOL_WEB_PORT=8080
# Cổng SearXNG trên host (chỉ với --profile searxng).
SALETOOL_SEARXNG_PORT=8888
# true = build kèm Playwright + chromium (ảnh nặng thêm ~700MB).
SALETOOL_INSTALL_BROWSER=false
