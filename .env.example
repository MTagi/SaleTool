# Docker: keep the secret stable to preserve encrypted data.
SALETOOL_SECRET_KEY=
SALETOOL_API_PORT=8000

# API credentials; application Settings are still stored in the database.
APOLLO_API_KEY=
TAVILY_API_KEY=

# AI: API key and model only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# MongoDB on the internal Docker network; do not publish its port to the host.
COMPOSE_PROFILES=mongo
SALETOOL_DB_BACKEND=mongo
SALETOOL_MONGO_URI=mongodb://mongo:27017
SALETOOL_MONGO_DB=saletool
